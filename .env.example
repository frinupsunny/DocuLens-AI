# ==============================================================================
# DocuLens AI - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your real '.env' file to Git!
# ==============================================================================

# OpenAI API Key (Required for Question Answering LLM)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default LLM Model (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
DEFAULT_LLM_MODEL=gpt-4o-mini

# Optional: Embedding model name from Hugging Face
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
